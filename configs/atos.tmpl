# ecefast configuration, schema 2: ECMWF Atos (HPC).
# Copy to configs/atos.yml (gitignored) and set the paths. Every key is described in docs/configuration.rst.
# Keys shown commented out are optional; the value shown is the default.
#
# Sections follow the components: `ecefast <component> <command>` reads section <component>.<command>
# (`ecefast nemo domain` -> nemo.domain), `ecefast eocene run` reads eocene. Every command writes only to its own
# output_dir. Any string may refer to another value with a {section.key} placeholder, e.g. {inputs.herold},
# {nemo.grid} or {nemo.domain.output_dir}.

schema: 2                       # configuration schema version (required)

# Read-only inputs, shared by every command (required section; both must exist)
inputs:
  ece4_data: /path/to/ECE4-DATA-V3        # EC-Earth4 input tree
  herold: /path/to/herold-et-al-2014/Supp # Herold et al. (2014) supplementary data

# tmpdir: null                  # scratch directory of every command (OIFS intermediate files); null: none

machine:
  name: atos                    # where DOMAINcfg runs: atos (here), local (laptop, not available) or fake (tests)
  atos:
    # profile: atos             # HPC modules to load: a profile of ecefast/tools/hpc_profiles.yaml
    oasis_lib_dir: /path/to/ecearth4/sources/oasis3-mct-5.2/arch_ecearth/lib  # added to LD_LIBRARY_PATH (default null)

# OIFS settings
# oifs:
#   grid: TL63L31               # OIFS resolution (directory under oifs/)

# NEMO settings and commands
nemo:
  # grid: PALEORCA2             # NEMO grid (directory under oasis/ and nemo/domain/), also the grid the domain pipeline builds

  # NEMO domain pipeline (`ecefast nemo domain`); omit if you do not run it
  domain:
    output_dir: /path/to/OUTPUT/nemo-domain  # only output: nemo/domain/<grid>/<name>/ (final files) and work/ (required)
    tools_dir: /path/to/ecearth4/sources/nemo-4.2/tools  # NEMO tools dir holding DOMAINcfg/ (namelists and DOMAINcfg run there)
    coords_ori: /path/to/data/PALEORCA2/coords_ori.nc   # PALEORCA2 coordinates with halo, NEMO 3.6 (required)
    source_grid: eORCA1       # grid of the present_day bathymetry; read from {inputs.ece4_data}/nemo/domain/<source_grid>/domain_cfg.nc (required)
    # staggering:             # staggering of the coordinate bounds, T or F
    #   source: T             # source grid (used in setgrid)
    #   target: T             # target grid (used in remapping)
    minimum_depth: 30         # m; depths 0 < d < minimum_depth are raised to it (required)

    # Steps to run. On Atos the whole pipeline runs, DOMAINcfg included.
    steps:
      coordinates: true
      bathymetry: true
      configure_domain: true
      domain_cfg: true          # run DOMAINcfg (Atos only)
      generate_mask: true       # post-process domain_cfg.nc and extract maskutil.nc (needs DOMAINcfg output)
      generate_subbasins: true  # ocean subbasin masks, every bathymetry (needs DOMAINcfg output)

    # One entry per bathymetry source: name (output and namelist names), enabled, processor (BathymetryProcessor
    # class: PROCESSORS in components/nemo/bathymetry, EOCENE_PROCESSORS in paleo/eocene/bathymetry.py) and
    # source_file. Algorithm choices (variable, mask, remapping) live in the processor class.
    bathymetries:
      - name: present_day
        enabled: true
        processor: PresentDayBathymetry
        source_file: "{inputs.ece4_data}/nemo/domain/eORCA1/domain_cfg.nc"
        orca2_file: "{inputs.ece4_data}/nemo/domain/ORCA2/domain_cfg.nc"   # enables the land-sea mask comparison plot

      - name: eocene
        enabled: true
        processor: EoceneBathymetry
        source_file: "{inputs.herold}/herold_etal_stddev_subgrid_etopo1_to_eocene_1x1.nc"

# Eocene (DeepMIP) workflow (`ecefast eocene run`)
eocene:
  output_dir: /path/to/OUTPUT/eocene      # the Eocene EC-Earth tree; --overwrite replaces it (required)
  domain:                                 # the Eocene NEMO domain the `domain` step installs (required)
    from: "{nemo.domain.output_dir}/nemo/domain/{nemo.grid}/eocene"   # output of `ecefast nemo domain`
    build: false                # true: build it first with nemo.domain (eocene bathymetry), in the `domain` step
  # oifs:
  #   aerosols: false           # build the Herold Eocene aerosol climatology (EoceneOIFS.aerosols); off
  # oasis:
  #   constant_sst: 290.0       # SST (K) written everywhere in OASIS rstos.nc (value used so far, placeholder)
