# ecefast configuration, schema 2: laptop / workstation.
# Copy to configs/laptop.yml (gitignored) and set the paths. Every key is described in docs/configuration.rst.
# Keys shown commented out are optional; the value shown is the default.
#
# Sections follow the time periods: `machine` (where), `grids` (the model resolution, shared by every period),
# then one section per period, `present` and `eocene`. A period has `input` (the EC-Earth tree it starts from,
# read-only), `output` (the tree it makes) and one subsection per component.
#   ecefast <period> run -c CONFIG                       the whole period
#   ecefast <component> run -c CONFIG [--period eocene]  one component of one period (default: present)
# Any string may refer to another value with a {section.key} placeholder, e.g. {present.input}.

schema: 2                       # configuration schema version (required)

machine:
  # name: local                 # where DOMAINcfg runs: local (not available), atos (ECMWF Atos) or fake (tests)
  tmpdir: /path/to/tmp/ecefast   # intermediate files of every command: <tmpdir>/<period>/<component>/ (required)

# Model resolution, shared by every period
grids:
  # oifs:
  #   name: TL63L31             # OIFS resolution (directory under oifs/)
  #   startdate: '19900101'     # initial-state folder under oifs/<name>/; quote it
  #   climate_version: climate.v020   # climate files folder under oifs/<name>/: climate.v020 for cy48, v015 for cy43
  nemo:
    # name: PALEORCA2           # NEMO grid (directory under oasis/ and nemo/domain/)
    coords_ori: /path/to/data/PALEORCA2/coords_ori.nc   # its coordinates with halo (NEMO 3.6), to build a domain
    # staggering: T             # staggering of the grid's coordinate bounds used in remapping, T or F

# Present-day period: `ecefast nemo run` (and `ecefast oifs run`, inputs on Atos only)
present:
  input: /path/to/ECE4-DATA-V3        # EC-Earth4 input tree, read-only (required)
  output: /path/to/OUTPUT/present     # nemo/domain/<grid>/, oifs/<grid>/ (required)
  # oifs: OIFS base data from a finer grid; its inputs are on Atos only, see configs/atos.tmpl
  nemo:                               # present-day NEMO domain, bathymetry of {input}/nemo/domain/<source_grid>/
    source_grid: eORCA1               # NEMO grid of the present-day bathymetry (needs strait corrections for it)
    # source_staggering: T            # staggering of its coordinate bounds (used in setgrid), T or F
    minimum_depth: 30                 # m; depths 0 < d < minimum_depth are raised to it (required)
    steps:                            # DOMAINcfg runs only on Atos: its steps are off on a laptop
      # coordinates: true
      # bathymetry: true
      # configure_domain: true
      domain_cfg: false               # run DOMAINcfg (Atos only)
      generate_mask: false            # post-process domain_cfg.nc and extract maskutil.nc (needs DOMAINcfg output)
      generate_subbasins: false       # ocean subbasin masks (needs DOMAINcfg output)

# Eocene (DeepMIP) period: `ecefast eocene run`
eocene:
  input: "{present.input}"            # EC-Earth tree to start from: the present-day one (required)
  herold: /path/to/herold-et-al-2014/Supp   # Herold et al. (2014) supplementary data, read-only (required)
  output: /path/to/OUTPUT/eocene      # the Eocene EC-Earth tree; --overwrite replaces it (required)
  nemo:
    domain: /path/to/data/domain/PALEORCA2/eocene   # directory with the Eocene domain_cfg.nc + maskutil.nc built
                                      # on Atos; `build` builds it, not possible with machine.name: local (required)
    minimum_depth: 30                 # m, used to build the domain (required)
  # oifs:
  #   aerosols: false                 # build the Herold Eocene aerosol climatology (EoceneOIFS.aerosols); off
  # oasis:
  #   constant_sst: 290.0             # SST (K) written everywhere in OASIS rstos.nc (value used so far, placeholder)
